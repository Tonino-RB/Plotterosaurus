[Unit]
Description=Plotterosaurus
After=network.target

[Service]
Type=simple
Environment=PLOTTER_MODEL=2
Environment=ENABLE_CAMERA=0
Environment=ENABLE_DRAW_STREAM=0
ExecStart=__WORKDIR__/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
WorkingDirectory=__WORKDIR__
User=__SERVICE_USER__
Restart=on-failure
RestartSec=3
# AmbientCapabilities grants low-port binding without running as root.
# We deliberately do NOT set CapabilityBoundingSet: the shutdown button shells
# out via `sudo`, which needs CAP_SETUID/CAP_SETGID to transition UIDs — those
# would be filtered out by a narrower bounding set.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# A ceiling on this service so that an in-process memory spike is this app's
# problem and not the whole board's. The preview already runs in a killable
# subprocess with its own 1GB RSS bound; what is left in-process is the vpype
# ink parse, lxml holding a large document, and uploads (MAX_UPLOAD_BYTES is
# held whole in memory, once per concurrent request across a 40-thread pool).
# Without this the kernel OOM killer picks the victim, and it may not be us.
# 2G of the board's 3.7G: enough headroom that normal work never reaches it,
# low enough that systemd kills and restarts us before the Pi starts swapping.
MemoryAccounting=yes
MemoryMax=2G

[Install]
WantedBy=multi-user.target
