venv/
__pycache__/
*.pyc
.pytest_cache/
uploads/*
!uploads/.gitkeep
calibration/*
!calibration/.gitkeep
# Real drawings the suite runs against when they are present (tests/conftest.py).
# Your own artwork: megabytes each, and not this repo's to publish.
tests/real/*
!tests/real/.gitkeep
recordings/
.DS_Store
.claude/
config.json
state.json
# Scratch files the atomic saves rename from. Present only between a write and
# its os.replace, or after a crash in that window — an empty state.json.tmp
# has been committed by accident once already.
config.json.tmp
state.json.tmp
draw_trace.jsonl
update.log
update.lock
*.swp
*.swo
*~
